{
  "name": "@lexogrine/dotagsi",
  "version": "1.5.5",
  "description": "DotA2 GSI Parser",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^14.14.35",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.3.0",
    "prettier": "^2.2.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint . --ext .ts",
    "prettier-format": "prettier --config .prettierrc --write **/*.ts",
    "post-compile": "npm run prettier-format && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexogrine/dota2gsi.git"
  },
  "author": "Lexogrine",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lexogrine/dota2gsi/issues"
  },
  "homepage": "https://lexogrine.com/technology/nodejs-development-company"
}
